# ==============================================================================
# GeoMeasure Studio — Environment Configuration & Credentials Template
# ==============================================================================
# Copy this file to '.env' and populate your local settings or API keys:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux / macOS)

# ------------------------------------------------------------------------------
# 1. Server Network Settings
# ------------------------------------------------------------------------------
GEO_HOST=127.0.0.1
GEO_PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Storage Location
# ------------------------------------------------------------------------------
GEO_DB_PATH=data/geomeasure.db

# ------------------------------------------------------------------------------
# 3. Security, Quotas & Ingestion Boundaries
# ------------------------------------------------------------------------------
GEO_MAX_UPLOAD_BYTES=52428800          # 50 MB upload ceiling
GEO_MAX_UNCOMPRESSED_BYTES=209715200   # 200 MB archive decompression quota
GEO_MAX_ZIP_MEMBERS=100                # Maximum files in zip/kmz archive
GEO_MAX_FEATURES=10000                 # Maximum features allowed per file
GEO_MAX_WARNINGS=50                    # Warning message cutoff per file
GEO_CHUNK_SIZE_BYTES=1048576           # 1 MB streaming chunk buffer

# ------------------------------------------------------------------------------
# 4. API Security & Rate Limiting (Optional)
# ------------------------------------------------------------------------------
# Set GEO_API_KEY to enforce X-API-Key header authentication on all protected endpoints.
# When empty (default), the API operates in open-access mode.
GEO_API_KEY=

# Number of concurrent background ingestion workers for async /api/async/ingest/ endpoint.
GEO_ASYNC_WORKERS=4


# ------------------------------------------------------------------------------
# 4. Third-Party Geospatial API Keys (Optional)
# ------------------------------------------------------------------------------
# Free defaults (Esri World Imagery, CartoDB Dark, OpenStreetMap) work out-of-the-box.
# If you have personal API keys, paste them below to enable premium tile tiers:

# Mapbox Access Token: unlocks 512px retina satellite streets & custom vector styles
MAPBOX_ACCESS_TOKEN=

# CARTO API Key (Optional)
# Note: CARTO Dark Matter and Positron raster basemap tiles are completely FREE
# and work out-of-the-box with NO API key needed.
# If you have a CARTO Enterprise Maps account for private vector datasets, paste it here:
CARTO_API_KEY=

# OpenTopography API Key: enables sub-meter LiDAR and SRTM terrain elevation queries
OPENTOPOGRAPHY_API_KEY=

# OpenStreetMap Nominatim User-Agent string
NOMINATIM_USER_AGENT=GeoMeasureStudio/1.0 (contact@geomeasure.org)

# ------------------------------------------------------------------------------
# 5. Author & Engineering Attribution
# ------------------------------------------------------------------------------
GEO_AUTHOR_NAME=Raghunath
GEO_AUTHOR_GITHUB=https://github.com/Raghunath2604
GEO_REPOSITORY_URL=https://github.com/Raghunath2604/geospatial-measurement-api
